# Real local-model configuration. Copy this file to backend/.env only after
# the model dependencies and weights have been installed and cached on D:.
MOCK_MODE=false
MOCK_GEOMETRY=false
LOCAL_PLANNER_ENABLED=true
# This handoff machine has an offline local copy. On another machine replace
# this with its verified local model directory before enabling LOCAL_FILES_ONLY.
LOCAL_PLANNER_MODEL=D:/CodexProjects/luna-model-cache/run-20260915-p08/moondream2-2025-06-21
LOCAL_PLANNER_REVISION=2025-06-21
LOCAL_FILES_ONLY=true
LOCAL_PLANNER_DETECT_REGIONS=false
# Default delivery route: restore the photo-supported MoGe surface and add
# bounded category structure. The coarse route remains an explicit fallback.
QUALITY_SCENE_ENABLED=true
COARSE_SCENE_ENABLED=true
MOGE_VERSION=v2
MOGE_PRETRAINED=D:/CodexProjects/luna-model-cache/run-20260915-p08/moge-2-vits-normal/model.pt
MOGE_QUICK_RESIZE=768
MOGE_FULL_RESIZE=1280
LOCAL_PLANNER_CACHE=D:/CodexProjects/luna-model-cache/run-20260915-p08/huggingface
HF_HOME=D:/CodexProjects/luna-model-cache/run-20260915-p08/hf-home
HF_MODULES_CACHE=D:/CodexProjects/luna-model-cache/run-20260915-p08/hf-home/modules
TRANSFORMERS_CACHE=D:/CodexProjects/luna-model-cache/run-20260915-p08/huggingface
MOONDREAM_TOKENIZER_PATH=D:/CodexProjects/luna-model-cache/run-20260915-p08/starmie-v1
MPLCONFIGDIR=D:/CodexProjects/luna-model-cache/run-20260915-p08/matplotlib
SCENE_TTL_HOURS=24
MAX_UPLOAD_BYTES=10485760
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=../data
EXPERIMENTAL_CONTEXT_SHELL=false
