# Safe local demo configuration. Copy this file to backend/.env for the first run.
# It uses the mock planner/geometry path and does not download model weights.
MOCK_MODE=true
MOCK_GEOMETRY=true
LOCAL_PLANNER_ENABLED=false
LOCAL_FILES_ONLY=true
LOCAL_PLANNER_DETECT_REGIONS=false
MOGE_VERSION=v2
MOGE_PRETRAINED=Ruicheng/moge-2-vits-normal
MOGE_QUICK_RESIZE=768
MOGE_FULL_RESIZE=1280
SCENE_TTL_HOURS=24
MAX_UPLOAD_BYTES=10485760
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=../data
EXPERIMENTAL_CONTEXT_SHELL=false
