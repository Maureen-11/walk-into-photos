# Copy to .env for local use. Never commit the real file.
MOCK_MODE=false
MOCK_GEOMETRY=false
LOCAL_PLANNER_ENABLED=true
LOCAL_PLANNER_MODEL=vikhyatk/moondream2
LOCAL_PLANNER_REVISION=2025-06-21
#首次下载模型时为 false；模型缓存完成后改为 true 才是断网运行。
LOCAL_FILES_ONLY=false
LOCAL_PLANNER_DETECT_REGIONS=false
# Deterministic deadline route for a valid upload; MoGe remains an optional
# isolated experiment when this is set to false.
COARSE_SCENE_ENABLED=true
QUALITY_SCENE_ENABLED=true
MOGE_VERSION=v2
MOGE_PRETRAINED=Ruicheng/moge-2-vits-normal
MOGE_QUICK_RESIZE=768
MOGE_FULL_RESIZE=1280
# Keep downloaded model weights on D: when running locally.
HF_HOME=D:/Codex/2026-09-09/new-chat/walk-into-photos/model-cache/huggingface
MPLCONFIGDIR=D:/Codex/2026-09-09/new-chat/walk-into-photos/model-cache/matplotlib
SCENE_TTL_HOURS=24
MAX_UPLOAD_BYTES=10485760
# Comma-separated browser origins allowed to call this server. For a remote
# generation server, set this to the exact URL where the experience client is
# hosted; do not use '*' together with cookies.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=../data
# Experimental only: adds clearly labelled procedural side/back context to
# indoor and terrain candidates. It is not a real-space reconstruction.
EXPERIMENTAL_CONTEXT_SHELL=true
